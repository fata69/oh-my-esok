<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/money_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/agenda_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/money_today_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_money_today"
            android:textColor="@color/agenda_widget_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/money_today"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_money_placeholder"
            android:textColor="@color/widget_negative"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_money_month_short"
            android:textColor="@color/agenda_widget_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/money_month"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginTop="1dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_money_placeholder"
            android:textColor="@color/agenda_widget_ink"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/money_plus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_plus_bg"
        android:contentDescription="@string/widget_add_transaction"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/agenda_widget_add" />
</LinearLayout>
